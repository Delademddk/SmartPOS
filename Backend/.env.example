# ==========================================================================
# SmartPOS Backend - Environment Configuration
# --------------------------------------------------------------------------
# Copy this file to .env and fill in real values. Never commit .env.
# ==========================================================================

# --- Application -----------------------------------------------------------
APP_NAME=SmartPOS API
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- SQL Server database ---------------------------------------------------
# ODBC Driver 17 or 18 for SQL Server is required on the host machine.
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=SmartPOS
DB_USERNAME=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
# Optional full connection string. If set, it takes precedence over the
# individual DB_* variables above. Example (pymssql):
# DATABASE_URL=mssql+pymssql://user:pass@localhost:1433/SmartPOS
DATABASE_URL=

# --- Security / JWT --------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
LOCKOUT_THRESHOLD=5

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed origins. Frontend dev server default below.
FRONTEND_URL=http://localhost:5173

# --- Rate limiting ---------------------------------------------------------
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=900
GENERAL_RATE_LIMIT=1000
GENERAL_RATE_WINDOW_SECONDS=60

# --- Logging ---------------------------------------------------------------
LOG_DIR=logs
ENABLE_ACCESS_LOG=true
ENABLE_AUDIT_LOG=true
ENABLE_NOTIFICATIONS=true
