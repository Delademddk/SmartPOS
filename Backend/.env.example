# ============================================================
# SmartPOS Backend Environment Configuration
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_NAME=SmartPOS API
APP_VERSION=1.0.0
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------
# SQL Server Database
# ------------------------------------------------------------
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=SmartPOS
DB_USERNAME=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server

# Optional:
# If DATABASE_URL is supplied, it takes precedence over the
# individual DB_* settings.
DATABASE_URL=

# ------------------------------------------------------------
# Security / JWT
# ------------------------------------------------------------
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
LOCKOUT_THRESHOLD=5

# ------------------------------------------------------------
# CORS
# Multiple frontend URLs can be separated with commas.
# ------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=900
GENERAL_RATE_LIMIT=1000
GENERAL_RATE_WINDOW_SECONDS=60

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
LOG_DIR=logs
ENABLE_ACCESS_LOG=true
ENABLE_AUDIT_LOG=true
ENABLE_NOTIFICATIONS=true

# ------------------------------------------------------------
# Product Image Storage
# ------------------------------------------------------------
# Development:
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=uploads/products

MAX_PRODUCT_IMAGE_SIZE=2097152
ALLOWED_PRODUCT_IMAGE_TYPES=image/jpeg,image/png,image/webp
PRODUCT_IMAGE_MAX_DIMENSION=1600

# ------------------------------------------------------------
# AWS S3
# These remain empty during local development.
# We will configure them when we deploy to AWS.
# ------------------------------------------------------------
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=