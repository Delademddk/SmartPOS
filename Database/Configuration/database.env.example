# ============================================================================
# SmartPOS Database Configuration
# Copy this file to `.env` and fill in real values.
#
# THIS FILE MUST NEVER CONTAIN REAL CREDENTIALS.
# It only holds PLAACEHOLDER values for local configuration.
# ============================================================================

# --- Server connection (required) ---
DB_HOST=localhost
DB_PORT=1433
DB_INSTANCE=                          # Optional SQL Server named instance, e.g. MSSQLSERVER
DB_USERNAME=sa
DB_PASSWORD=ChangeMe_StrongPassword_2026

# --- Database ---
DB_NAME=SmartPOS
DB_TRUSTED_CONNECTION=false          # true = Windows/Active Directory auth, false = SQL auth

# --- SQLCMD (used by setup/verify/backup/restore scripts) ---
SQLCMD_BINARY=sqlcmd
SQLCMD_TIMEOUT=60

# --- Backup settings ---
BACKUP_DIR=./Backup
BACKUP_KEEP_DAYS=14

# --- Install settings ---
DB_CREATE_BATCH_SIZE=1000            # Batch size for large bulk operations
DB_DEFAULT_COLLATION=SQL_Latin1_General_CP1_CI_AS

# --- Schema ---
DB_SCHEMA=dbo
DB_RESTORE_SNAPSHOT=false